// road_projected_route.fbs — RoadSurfaceProjector's output, consumed by ArRenderer. See
// docs/BUILD_GUIDE.md Part 3.5, Part 10.3, Part 11.4.
//
// Internal host-side message format — used between subsystems that communicate across thread
// boundaries via the Part 5.3 message bus. Distinct from the host<->hub wire protocol in
// vehicle/HubProtocol.h, which is raw packed structs over serial.
//
// C++ headers are generated by flatc (cmake/FlatBufferSchemas.cmake) into the build tree, never
// committed (Part 3.5). The object API is enabled, so each table T also gets a plain struct TT
// (e.g. ActuationRequestT) — see common/Types.h for why the bus carries those.

namespace ar_drive_assist.schema;

table RoadOverlayPoint {
  image_x: float; image_y: float;
  world_distance_m: float;
  on_measured_surface: bool;   // true = locked to real LiDAR ground geometry, false = flat-ground fallback
}

table RoadProjectedRoute {
  timestamp_ms: ulong;
  polyline: [RoadOverlayPoint];
  next_turn_instruction: string;
  next_turn_distance_m: float;
}
root_type RoadProjectedRoute;
