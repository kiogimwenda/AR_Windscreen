# Claude Code's own local state — never committed, no exceptions.
.claude/

# Build outputs
build/
host/build/
host/test/unit/build/
host/test/unit/build-*/
firmware/sensor_actuator_hub/.pio/

# Regenerable / hardware-specific ML artifacts (Part 7.3) — never portable across machines
host/models/onnx/
host/models/engines/
host/models/weights/

# Runtime logs (Part 5.4, Part 11.6)
logs/

# IDE
.idea/
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Recorded/downloaded video for offline testing (large; source and licence in data/README.md)
data/footage/

# Sign-detector training runs and datasets (large; overnight run 2026-09-24/25)
host/models/training/
data/datasets/

# Model weights downloaded by tools (e.g. ultralytics fetches yolo26n.pt into the working
# directory for its AMP check). Project weights live in host/models/weights/, already ignored.
*.pt

# Offline OSM extracts and OSRM routing data (Part 11.2; rebuilt by scripts/refresh_osm.sh)
data/maps/

# Recorded GPS drives (GPX): private location history, never committed (Phase 8 nav_replay)
data/drives/

# Third-party legal documents kept for reference only (copyrighted; cite the URL instead)
docs/Tomtom's terms.pdf

# Python bytecode
__pycache__/
*.pyc

# KiCad: per-user settings, backups, caches and generated check outputs (check.sh remakes them)
*.kicad_prl
*-backups/
fp-info-cache
hardware/*/erc.rpt
hardware/*/*.net
