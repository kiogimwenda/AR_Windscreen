	(text "SENSORS AND LOCAL CONNECTORS. Breakouts on standoffs; MATCH EACH HEADER'S PIN ORDER TO THE\nBREAKOUT YOU BUY before layout. Names are the MCU's view (GPS_TX goes to the module's RX)."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "6d03f934-bfb5-4682-9701-41d7b855f9a8")
	)
	(text "BNO085 IMU (I2C1, 4.7 k pull-ups R5/R6): J2 is pin for pin the Adafruit 4754's\nJP1 row (VIN 3Vo GND SCL SDA INT; 3Vo, its regulator output, left open).\nJ8: optional wire to the breakout's RST. Mount rigidly: it measures the car's motion."
		(exclude_from_sim no)
		(at 284.48 50.8 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "d17619aa-65d2-4bff-8c20-3c6c8cfd3b72")
	)
	(text "NEO-M8N GNSS (USART2, PPS for timing)."
