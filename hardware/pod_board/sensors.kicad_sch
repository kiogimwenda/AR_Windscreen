			)
			(justify left bottom)
		)
		(uuid "b3c82bab-5362-4de9-9bab-1b6609cabeab")
	)
	(text "Gesture puck: APDS-9960 on ~1.5 m of cable\n(I2C2 at 100 kHz; 2.2 k pull-ups for the cable)."
