	(text "CAN (ISO 15765-4) to the car's OBD-II port, on this board so the unterminated branch off the\ncar's bus is only the ~0.5 m OBD lead. R59 holds TX recessive and R60 holds Rs high (standby,\ncannot transmit) whenever the pod is not driving them. No termination: the car has its two."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0b41e432-385d-4954-9ded-4acc638e6e0e")
	)
